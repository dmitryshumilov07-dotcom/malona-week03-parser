PARSER_API_KEY=dev-parser-key-change-me
PARSER_VERSION=1.0.0
# Use recorded HTML snapshots for whitelist URLs (recommended for demo / anti-bot).
PARSER_USE_PAGE_SNAPSHOTS=1
# Min pause between outbound requests to the same supplier_id (seconds).
PARSER_SUPPLIER_PAUSE_SEC=2
# Rate limit: requests per minute per API key.
PARSER_RATE_LIMIT_PER_MIN=60
# Max parallel lookups per supplier_id.
PARSER_MAX_PARALLEL_PER_SUPPLIER=5
